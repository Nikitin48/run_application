# =============================================================================
# .env.release — БД для релиза (Yandex Managed PostgreSQL)
# Скопируй: cp env.example.release .env.release
# Используется при ./run.sh release
# =============================================================================

# Вариант 1: одна строка (подставь хост, логин, пароль из консоли Yandex Cloud)
# DATABASE_URL=postgresql://run_app_user:PASSWORD@c-xxx.rw.mdb.yandexcloud.net:6432/run_app?sslmode=require

# Вариант 2: отдельные параметры (удобно заполнять по полям)
DB_HOST=c-xxx.rw.mdb.yandexcloud.net
DB_PORT=6432
DB_NAME=run_app
DB_USER=run_app_user
DB_PASSWORD=твой_пароль
# sslmode=require обязателен для Managed PostgreSQL
DB_SSLMODE=sslmode=require
