# =============================================================================
# Базовые настройки (общие для local и release)
# Скопируй в .env и заполни
# =============================================================================

APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

# JWT (используй разные секреты для local и release!)
JWT_SECRET=change_me
JWT_ISSUER=run-application
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Фоновое разрешение спорных территорий (resolve_at)
TERRITORY_CONTEST_RESOLVE_ENABLED=true
TERRITORY_CONTEST_RESOLVE_INTERVAL_SECONDS=15

# Firebase Cloud Messaging (server-side send)
FCM_ENABLED=false
# Absolute path to Firebase service-account JSON.
FCM_SERVICE_ACCOUNT_JSON_PATH=

# =============================================================================
# DATABASE_URL — задаётся в .env.local или .env.release (см. ниже)
# Если этих файлов нет, можно указать здесь
# =============================================================================
