# =============================================================================
# Базовые настройки (общие для local и release)
# Скопируй в .env и заполни
# =============================================================================

APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

# JWT (используй разные секреты для local и release!)
JWT_SECRET=change_me
JWT_ISSUER=run-application
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# =============================================================================
# DATABASE_URL — задаётся в .env.local или .env.release (см. ниже)
# Если этих файлов нет, можно указать здесь
# =============================================================================
