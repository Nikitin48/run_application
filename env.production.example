# =============================================================================
# Скопируй на VPS рядом с docker-compose.prod.yml как файл `.env`.
# Важно: не коммить реальный `.env` с паролями.
# =============================================================================

# Для docker compose (подстановка в сервис db)
POSTGRES_USER=run_app
POSTGRES_PASSWORD=сгенерируй_длинный_пароль
POSTGRES_DB=run_app

# Образ backend из GHCR (после CI: теги latest и sha-<полный_sha>)
# На сервере можно задать в .env или только через export в SSH-деплое (см. deploy/README.md)
# BACKEND_IMAGE=ghcr.io/<owner>/<repo>-backend:latest

# Переменные приложения (см. python_backend/env.example)
APP_ENV=release
JWT_SECRET=сгенерируй_другой_длинный_секрет
JWT_ISSUER=run-application
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Строка подключения к контейнеру Postgres (hostname сервиса в compose — db)
# Если в пароле есть спецсимволы — URL-encode (например @ -> %40)
DATABASE_URL=postgresql://run_app:сгенерируй_длинный_пароль@db:5432/run_app

# Облачная managed БД не используется в этом compose — не задавайте DB_SSLMODE,
# если подключаетесь к контейнеру db.

# FCM (опционально). На сервере: см. deploy/FCM_PRODUCTION.md и docker-compose.fcm.yml
# FCM_ENABLED=true
# FCM_SERVICE_ACCOUNT_JSON_PATH=/secrets/firebase-adminsdk.json
