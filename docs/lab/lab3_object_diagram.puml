@startuml
title Диаграмма объектов — сценарий завершения пробежки
top to bottom direction
scale max 1000 width

skinparam objectAttributeIconSize 0
skinparam objectFontSize 10
skinparam objectAttributeFontSize 9
skinparam nodesep 8
skinparam ranksep 10

' ====== Аутентификация ======
object "authState :AuthState" as authState {
  status = authenticated
}

object "myTokens :AuthTokens" as myTokens {
  accessToken = "eyJhbG..."
  accessExpiresAt = 1741100400
  refreshToken = "dGhpcyB..."
}

' ====== Трекер пробежки ======
object "trackerState :RunTrackerState" as trackerState {
  phase = finishing
  startedAt = 2026-03-04T10:00:00
}

object "pt1 :RunPoint" as pt1 {
  lat = 52.6031
  lng = 39.5708
  ts = 10:00:03
}

object "pt2 :RunPoint" as pt2 {
  lat = 52.6035
  lng = 39.5712
  ts = 10:00:08
}

object "pause1 :RunPause" as pause1 {
  startedAt = 10:05:00
  endedAt = 10:06:30
  reason = manual
}

object "finishResp :FinishRunResponse" as finishResp {
  runId = "a3b2c1d0-..."
  distanceM = 1523.7
  elapsedS = 900
  pausedS = 90
  movingS = 810
  captureAreaM2 = 48200.5
  victimsCount = 2
}

' ====== Территории ======
object "myTerr :Territory" as myTerr {
  userId = "user-001"
  areaM2 = 125430.0
  color = "#22C55E"
}

object "rivalTerr :Territory" as rivalTerr {
  userId = "user-042"
  areaM2 = 87600.0
  color = "#EF4444"
}

' ====== Уведомление ======
object "notif :LastNotification" as notif {
  kind = "territory_stolen"
  attackerUserId = "user-042"
  stolenAreaM2 = 3200.0
}

' ====== Профиль ======
object "profile :MeProfile" as profile {
  id = "user-001"
  displayName = "Максим"
  territoryColor = "#22C55E"
}

object "stats :MeProfileStats" as stats {
  runCount = 47
  totalDistanceM = 182500.0
  ownedAreaM2 = 125430.0
}

' ====== История ======
object "histItem :RunHistoryItem" as histItem {
  runId = "a3b2c1d0-..."
  status = "processed"
  distanceM = 1523.7
  captureAreaM2 = 48200.5
}

' ====== Бэкенд ======
object "settings :Settings" as settings {
  app_port = 8000
  jwt_secret = "***"
  database_url = "postgresql://...@127.0.0.1/run_app"
}

' ====== СВЯЗИ ======
authState --> myTokens

trackerState --> pt1
trackerState --> pt2
trackerState --> pause1
trackerState --> finishResp

profile --> stats

histItem .. finishResp : одна\nпробежка

@enduml
