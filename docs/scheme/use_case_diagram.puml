@startuml use_case_diagram
left to right direction

actor "Гость" as Guest
actor "Авторизованный пользователь" as User
actor "Администратор/оператор" as Admin

rectangle "Run Application" {
  usecase "Регистрация" as UC_Register
  usecase "Вход в систему" as UC_Login
  usecase "Просмотр карты территорий" as UC_ViewMap
  usecase "Получение текущей геопозиции" as UC_GetLocation
  usecase "Завершение пробежки\nс передачей трека" as UC_RunFinish
  usecase "Отправка трека и захват\nтерриторий" as UC_Capture
  usecase "Просмотр истории пробежек" as UC_History
  usecase "Просмотр/редактирование\nпрофиля" as UC_Profile
  usecase "Получение последнего\nуведомления" as UC_LastNotification
  usecase "Получение истории\nуведомлений (до 10)" as UC_NotificationHistory
  usecase "Регистрация push-токена\nустройства" as UC_RegisterPushToken
  usecase "Удаление push-токена\nустройства" as UC_DeletePushToken
  usecase "Формирование записи\nуведомления" as UC_CreateNotification
  usecase "Отправка push-уведомления" as UC_SendPush
  usecase "Очистка просроченных\nrefresh-токенов" as UC_TokenCleanup
}

Guest --> UC_Register
Guest --> UC_Login

User --> UC_ViewMap
User --> UC_RunFinish
User --> UC_History
User --> UC_Profile
User --> UC_LastNotification
User --> UC_NotificationHistory
User --> UC_RegisterPushToken
User --> UC_DeletePushToken

UC_ViewMap .> UC_GetLocation : <<include>>
UC_RunFinish .> UC_GetLocation : <<include>>
UC_RunFinish .> UC_Capture : <<include>>
UC_Capture .> UC_CreateNotification : <<include>>
UC_SendPush .> UC_Capture : <<extend>>

Admin --> UC_TokenCleanup

@enduml
