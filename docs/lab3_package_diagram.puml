@startuml
title Run Application — Диаграмма пакетов
top to bottom direction
scale max 1000 width

skinparam packageStyle rectangle
skinparam packageFontSize 11
skinparam packagePadding 8
skinparam nodesep 10
skinparam ranksep 10

package "FlutterApp" {
  package "App" as app_pkg
  package "Core" as core_pkg {
    package "Network" as net
    package "Storage" as stor
  }
  package "Auth" as auth
  package "Runs" as runs
  package "Territories" as terr
  package "Profile" as prof
  package "Notifications" as notif
  package "Histories" as hist
}

package "PythonBackend" {
  package "Routers" as rout
  package "Models" as mdl
  package "Security" as sec
  package "Settings" as sett
  package "Geo" as geo
}

package "External" {
  package "GPS SDK" as gps
  package "Connectivity" as conn
  package "OSM Tiles" as osm
  package "SecureStorage" as sstor
  package "PostgreSQL" as pg
}

app_pkg ..> auth
app_pkg ..> terr
app_pkg ..> hist
app_pkg ..> prof
app_pkg ..> runs

auth ..> net
runs ..> net
terr ..> net
prof ..> net
notif ..> net

net ..> stor
stor ..> sstor

runs ..> gps
runs ..> conn
terr ..> osm

hist ..> runs

net ..> rout : HTTP
rout ..> mdl
rout ..> sec
rout ..> sett
rout ..> geo
rout ..> pg

@enduml
