# Переменные для token_cleanup. Данные из python_backend/.env.release.
# Скопируй блок ниже, вставь пароль из .env.release в DB_PASSWORD, затем в консоль функции.
#
# Важно: в Cloud Functions хост *.mdb.yandexcloud.net может не резолвиться (DNS).
# Используй IP кластера: консоль Yandex Cloud → Managed PostgreSQL → кластер → «Хост» (или из прошлой ошибки подключения). Ниже — пример IP.
DB_HOST=89.169.185.121
DB_PORT=6432
DB_NAME=run_app_db
DB_USER=clausss
DB_PASSWORD=ВСТАВЬ_ПАРОЛЬ_ИЗ_.env.release
DB_SSLMODE=sslmode=require
